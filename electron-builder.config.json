{
  "appId": "com.aurasystem.app",
  "productName": "Aura System",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/main.cjs",
    "electron/preload.cjs",
    "electron/package.json",
    "dist/**/*",
